FORECAST_ENVIRONMENT=local
FORECAST_LOG_LEVEL=INFO
FORECAST_API_PREFIX=/v1
FORECAST_STATE_DIR=.forecast-state
# PostgreSQL metadata store.
FORECAST_DATABASE_URL=postgresql://localhost:5432/symmetrical-octo-waddle
FORECAST_DATABASE_POOL_MIN_SIZE=1
FORECAST_DATABASE_POOL_MAX_SIZE=10
FORECAST_MAX_WORKERS=2
FORECAST_MAX_UPLOAD_BYTES=2147483648
# JSON mapping of tenant IDs to API keys. Required in production.
FORECAST_API_KEYS={}
