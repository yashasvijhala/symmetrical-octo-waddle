ENVIRONMENT=local
DATABASE_URL=postgresql://localhost:5432/symmetrical-octo-waddle
STATE_DIR=.forecast-state
API_KEYS={}

# Keep "local" until a Cloudflare R2 bucket and Object Read & Write token exist.
OBJECT_STORE_BACKEND=local
R2_ENDPOINT=
R2_BUCKET=forecasting-artifacts
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Required by the Hatchet SDK. Do not rename.
HATCHET_CLIENT_TOKEN=
